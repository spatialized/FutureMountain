{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "214d2e9b42114125bc0019733c29a367",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "TerrainCoverMasks (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1065.0,
            "y": 739.0,
            "width": 264.0,
            "height": 245.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "63866727bc6a4bb59d5055ecbca4a84d"
        },
        {
            "m_Id": "bf1f3d09428f47f7958587b634350e08"
        },
        {
            "m_Id": "574a0d06ded84ae7a2537eb6b8401667"
        },
        {
            "m_Id": "9906ed6d3d114574aa2349869db6fbb1"
        },
        {
            "m_Id": "a2f7be78d3d649359ec04b40a89c2eaa"
        },
        {
            "m_Id": "d775aafaa255427ab4eeadabf75a1ac4"
        },
        {
            "m_Id": "22f8693c8ad54a87a1b4e3e8c1b2f1bc"
        },
        {
            "m_Id": "de495d98904542718b8bab2103f6e573"
        },
        {
            "m_Id": "352402e8ed7d4881b55560c638266678"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "TerrainCoverMasks",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Painted control: R = mud, G = grass. Litter (B) and burn (A) are placed by data, not by painting.\r\n  float painted   = Control.r + Control.g + Control.b + Control.a;\r\n  float grassVis  = Control.g * smoothstep(NoiseGrass - Edge, NoiseGrass + Edge, GrassCover);\r\n\r\n// Everything that is not visible grass is bare ground, which litter can then cover.\r\n  float bare      = painted - grassVis;\r\n  float litter    = bare * smoothstep(NoiseLitter - Edge, NoiseLitter + Edge, LitterCover);\r\n  float mud       = bare - litter;\r\n\r\n// Burn scars sit on the non-grass ground (data drops grass after a fire, exposing it).\r\n  float b         = smoothstep(NoiseBurn - Edge, NoiseBurn + Edge, BurnAmount);\r\n  float burn      = (mud + litter) * b;\r\n\r\n  Masks = float4(mud * (1 - b), grassVis, litter * (1 - b), burn);"
}

