%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0001cc40633e2242a75f7015c8a9162, type: 3}
  m_Name: Quest1_Level2
  m_EditorClassIdentifier: 
  title: "Quest 1 \xB7 Level 2"
  lockZoomOut: 1
  graphVariableMode: -1
  lockedScenario: -1
  lockedSpeedStep: -1
  graphSelectable: 0
  allowSideBySide: 0
  allowDifferentCubes: 0
  opening: "Maybe add a message: climate scenarios are important when modeling ecosystems
    because \u2026 this gives context but also a little introduction as this level
    currently does not have one. Explore the different climate variables in the quest
    panel and watch how they change over time. Based on the three descriptions and
    your observations, select the climate scenario name you think best represents
    the type of data you are seeing. When you are ready, press \u201Ccontinue to
    questions\u201D in the quest panel."
  ending: "That is correct. WRF\u2019s climate scenario is different from the others
    because the WRF model better captures local microclimate differences by using
    smaller spatial resolution than the other climate scenarios."
  defaultOptions: []
  questions:
  - prompt: "Match the following scenario description with the climate scenarios
      you saw previously:\n\u201CWRF: This climate scenario utilizes model results
      from the Weather Research Forecasting and Model, which allows scientists to
      parametrize different atmospheric models to better optimize for local climate
      conditions and features. This scenario is significantly drier with less rain
      and more windy days.\u201D"
    options:
    - Local Climate Model
    - Hotter & Drier Model
    - Historic Climate
    correctIndex: 0
    graphSelect: 0
    correctYearsByScenario: []
    textInput: 0
  - prompt: "\u201CRSClim: This climate scenario utilizes collected weather data
      from Mission Creek in Santa Barbara County, California for a historical period
      of time. This scenario is wetter and more humid than the other three, with
      warmer temperatures.\u201D \r\r\n"
    options:
    - Local Climate Model
    - Hotter & Drier Model
    - Historic Climate
    correctIndex: 1
    graphSelect: 0
    correctYearsByScenario: []
    textInput: 0
  - prompt: "\u201CHadGEM: This climate scenario, based on results from a Global
      Climate Model (GCM), generates a time series of climate inputs based on assumptions
      that California will experience warm and dry weather. [something about relative
      humidity and temperature/wind depending on relevance]\u201D "
    options:
    - Local Climate Model
    - Hotter & Drier Model
    - Historic Climate
    correctIndex: 2
    graphSelect: 0
    correctYearsByScenario: []
    textInput: 0
  - prompt: 'Congratulations, you have correctly identified the climate scenarios
      - for a reminder here are the following scenarios: Historic Climate is RSClim,
      Hotter & Drier Model is HadGEM, Local Climate Model is WRF.

      To move
      on to the next level/question, please select the scenario that contrasts the
      most with the others'
    options:
    - RSCLim
    - HadGEM
    - WRF
    correctIndex: 2
    graphSelect: 0
    correctYearsByScenario: []
    textInput: 0
