%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0001cc40633e2242a75f7015c8a9162, type: 3}
  m_Name: Quest1_Level1
  m_EditorClassIdentifier: 
  title: "Quest 1 \xB7 Level 1"
  lockZoomOut: 1
  graphPrecipOnly: 1
  allowSideBySide: 0
  opening: 'Characterize climate characteristics in each of the climate scenarios
    by selecting the appropriate precipitation, min/max temperature, wind, and relative
    humidity value for the listed prompts. You will then repeat this process across
    the three climate scenarios. Using the quest panel, alternate between each of the
    3 climate scenarios and complete the following tasks/questions:'
  ending: 'You have successfully demonstrated your ability to navigate through different
    climate scenarios & variables. Next, explore level two, where you will learn more
    about different climate scenarios!'
  defaultOptions: []
  questions:
  - prompt: 'Rainfall determines whether a year is dry or wet. Using the precipitation
      graph, select what years you would think are a wet year?'
    options: []
    correctIndex: 0
    graphSelect: 1
    correctYearsByScenario:
    - years: 030000001300000016000000
    - years: 050000000e000000130000002200000027000000
    - years: 020000000700000011000000130000001d000000
  - prompt: Using the precipitation graph, now select what you would think is a dry
      year?
    options: []
    correctIndex: 0
    graphSelect: 1
    correctYearsByScenario:
    - years: 01000000070000000d0000001a0000001f00000027000000
    - years: 06000000150000001b0000001e0000001f00000026000000
    - years: 0100000004000000170000001f00000026000000
  - prompt: 'A drought is categorized as 2+ years of dryness. Based on what you chose
      to be a "dry year", when would you expect there to be a drought? (hint: ensure
      you are clicking on at least two years)'
    options: []
    correctIndex: 0
    graphSelect: 1
    correctYearsByScenario:
    - years: 07000000080000002700000028000000
    - years: 1e0000001f00000020000000
    - years: 0d0000000e0000002500000026000000
