MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0001cc40633e2242a75f7015c8a9162, type: 3}
  m_Name: Quest2_Level3
  m_EditorClassIdentifier:
  title: "Quest 2 \xB7 Level 3"
  lockZoomOut: 0
  graphVariableMode: 11
  lockedScenario: -1
  allowSideBySide: 1
  allowDifferentCubes: 0
  opening: 'Let us take a look at how different climate scenarios affect recovery.
    We established what a drought was in quest 1, but how might prolonged periods
    of dryness affect recovery? Take a look at the North and the South as they both
    experience a fire during the beginning of a drought. Pay attention to the recovery
    (the speed at which it takes to return to a normal baseline). Then, repeat the
    exercise across the different climate scenarios.'
  ending:
  defaultOptions: []
  questions:
  - prompt: 'Based on what you noticed in terms of recovery and plant trajectories
      after fire, what is different when plants are recovering after a drought period
      in different climate scenarios?'
    options:
    - Recovery is slower and harder in the drier scenarios
    - Recovery is faster in the drier scenarios
    - The climate scenario has no effect on recovery
    - Only the wettest scenario shows any recovery
    correctIndex: 0
    graphSelect: 0
    correctYearsByScenario: []
  - prompt: 'What most helps plants re-establish and recover faster after a fire?'
    options:
    - More available water and deeper rooting depth
    - Less rainfall and shallower roots
    - Higher wind speeds
    - Lower humidity
    correctIndex: 0
    graphSelect: 0
    correctYearsByScenario: []
